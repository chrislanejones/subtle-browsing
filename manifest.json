{
  "manifest_version": 3,
  "name": "URL Blocker",
  "version": "1.9.0",
  "description": "Stop intrusive video, newsletter prompts and heavy ads while keeping ordinary banners.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "webRequest",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "video_ads",
        "enabled": true,
        "path": "rules/video-ads.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "rules/annoyances.json"
      },
      {
        "id": "notifications",
        "enabled": false,
        "path": "rules/notifications.json"
      },
      {
        "id": "ad_churn",
        "enabled": false,
        "path": "rules/ad-churn.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "commands": {
    "start-picker": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Select an ad to block"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Turn blocking off or on for this site"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "stubs/ima3.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
